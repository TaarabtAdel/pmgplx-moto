APP_NAME="KHGPLX MOTO"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8081

LOG_CHANNEL=stack
LOG_LEVEL=debug

# --- Live (một SQL Server, vd. ADMIN-PC) ---
DB_CONNECTION=sqlsrv
DB_HOST=ADMIN-PC
DB_PORT=1433
DB_DATABASE=GPLX_CDB_CSDT_MOTO
DB_USERNAME=sa
DB_PASSWORD=

# Phần mềm cũ + DB app (dò thông tin / quyền)
DB_DATABASE_2=GPLX_CSDT
DB_DATABASE_3=MANHLINH

# --- Docker Mac (ghi đè host + tên DB trong container) ---
# DB_CONNECTION=sqlsrv_moto
# DB_HOST=db
# DB_PASSWORD=YourPassword123!
# DB_DATABASE=GPLX_MOTO_BAN_MOI
# DB_DATABASE_2=GPLX_MOTO_BAN_CU
# DB_DATABASE_3=MANHLINH_MOTO

DB_ENCRYPT=yes
DB_TRUST_SERVER_CERTIFICATE=true

# SQL bản cũ trên máy khác: DB_HOST_2, DB_USERNAME_2, …

MOTO_STANDALONE=true

SESSION_DRIVER=file
CACHE_DRIVER=file
QUEUE_CONNECTION=sync

DO_THONG_TIN_PUBLIC_URL=http://localhost:8081
GOOGLE_VISION_API_KEY=
