APP_NAME="KHGPLX MOTO"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8081

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Hai DB GPLX mô tô (Docker: DB_HOST=db)
DB_CONNECTION=sqlsrv_moto
DB_HOST=127.0.0.1
DB_PORT=1433
DB_USERNAME=sa
DB_PASSWORD=
DB_DATABASE_4=GPLX_MOTO_BAN_MOI
DB_DATABASE_5=GPLX_MOTO_BAN_CU
DB_DATABASE_3=MANHLINH_MOTO

DB_ENCRYPT=yes
DB_TRUST_SERVER_CERTIFICATE=true

# Host / user / pass riêng cho bản cũ (khi SQL khác server)
# DB_HOST_5=
# DB_USERNAME_5=
# DB_PASSWORD_5=

MOTO_STANDALONE=true

SESSION_DRIVER=file
CACHE_DRIVER=file
QUEUE_CONNECTION=sync

# QR trang chụp CCCD/GPLX trên điện thoại (cùng LAN)
DO_THONG_TIN_PUBLIC_URL=http://localhost:8081

# Dò thông tin OCR (Google Cloud Vision) — để trống thì không dò ảnh
GOOGLE_VISION_API_KEY=
